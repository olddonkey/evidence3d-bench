{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "evidence3d-detail-set-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "task_id", "task_sha256", "status", "reference_sha256", "provenance", "categories", "cards"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
    "task_id": { "type": "string" },
    "task_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "enum": ["calibration_only", "admitted"] },
    "reference_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "provenance": {
      "type": "object", "required": ["kind", "evidence"],
      "properties": {
        "kind": { "enum": ["analytic_fixture", "independent_review"] },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "reviewers": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "categories": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "title", "weight"],
        "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "title": { "type": "string" }, "weight": { "type": "number", "exclusiveMinimum": 0 } }
      }
    },
    "cards": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "category", "weight", "scoreable", "source_ids", "requirements", "anchors", "views", "thresholds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,59}$" },
          "title": { "type": "string", "minLength": 1 },
          "category": { "type": "string" },
          "weight": { "type": "number", "exclusiveMinimum": 0 },
          "scoreable": { "type": "boolean" },
          "exclusion_reason": { "type": "string" },
          "source_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "requirements": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "anchors": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "string", "minLength": 1 } },
          "views": {
            "type": "array", "maxItems": 8,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "right", "up", "origin", "extent", "resolution", "depth_range"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z-]{0,39}$" },
                "right": { "$ref": "#/definitions/vector" },
                "up": { "$ref": "#/definitions/vector" },
                "origin": { "$ref": "#/definitions/vector" },
                "extent": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } },
                "resolution": { "type": "integer", "minimum": 32, "maximum": 384 },
                "depth_range": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
                "ignore_rects": { "type": "array", "items": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": 0, "maximum": 1 } } }
              }
            }
          },
          "thresholds": {
            "type": "object", "additionalProperties": false,
            "required": ["iou_min", "depth_mean_m_max", "depth_p95_m_max", "normal_mean_deg_max", "depth_pixel_tolerance_m", "depth_outlier_fraction_max"],
            "properties": {
              "iou_min": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
              "depth_mean_m_max": { "type": "number", "exclusiveMinimum": 0 },
              "depth_p95_m_max": { "type": "number", "exclusiveMinimum": 0 },
              "normal_mean_deg_max": { "type": "number", "exclusiveMinimum": 0, "maximum": 180 },
              "depth_pixel_tolerance_m": { "type": "number", "exclusiveMinimum": 0 },
              "depth_outlier_fraction_max": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    }
  },
  "definitions": { "vector": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } } }
}
